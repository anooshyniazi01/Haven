# Haven Environment Configuration Example
# Copy this file to .env and adjust variables as needed for local development.

# Application Environment (development | production | test)
APP_ENV=development

# Backend API Configuration
API_HOST=127.0.0.1
API_PORT=8000
API_V1_PREFIX=/api/v1

# SQLite Database Location
DATABASE_URL=sqlite:///./haven.db

# Storage root for uploaded media and evidence (outside public directory)
STORAGE_ROOT=./storage

# Upload restrictions
MAX_UPLOAD_SIZE_MB=25

# Permitted Frontend Origin for CORS
FRONTEND_ORIGIN=http://localhost:5173

# Logging Level (DEBUG | INFO | WARNING | ERROR)
LOG_LEVEL=INFO

# Vite Frontend API Base URL (used by frontend in .env)
VITE_API_BASE_URL=http://localhost:8000
